		<IncButtonName>RIGHT_BUTTON</IncButtonName>
		<DecButtonName>LEFT_BUTTON</DecButtonName>

		<!-- Установки заданной позиции по комбинации -->
		<PositionModkey>Alt</PositionModkey>
		<PositionKeys>(KEY_1;0),(KEY_2;1),(KEY_3;2),(KEY_4;3),(KEY_5;4),(KEY_6;5),(KEY_7;6)</PositionKeys>

		<ObjectNameCab1>Cab1_Kran395-ruk</ObjectNameCab1>
